{
  "id": "nl.jwienk.todoist",
  "version": "2.1.1",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "brandColor": "#db4035",
  "name": {
    "en": "Todoist",
    "nl": "Todoist"
  },
  "description": {
    "en": "Let your home keep your to-do list in check",
    "nl": "Laat je huis je takenlijst bijhouden"
  },
