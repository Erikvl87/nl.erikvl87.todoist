    ],
    "nl": [
      "todoist",
      "todo",
      "to-do",
      "to-dolijst",
      "taken",
      "takenlijst",
      "snel toevoegen",
      "herinneringen",
      "boodschappenlijst",
      "boodschappen",
      "checklist",
