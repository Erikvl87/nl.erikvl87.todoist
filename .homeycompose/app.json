      "dashboard"
    ]
  },
  "permissions": [],
  "images": {
    "large": "/assets/images/large.png",
    "small": "/assets/images/small.png"
  },
  "author": {
    "name": "Erik van Leeuwen",
    "email": "homey@erikvl87.nl"
  },
